+    accuracy = pd.DataFrame(accuracy_rows)
+    formats = pd.DataFrame(format_rows)
+    traffic = pd.DataFrame(traffic_rows)
+    cache = pd.DataFrame(cache_rows)
+    summary = pd.DataFrame(summaries)
+    decoder_rows = []
+    for cid in summary.config_id:
