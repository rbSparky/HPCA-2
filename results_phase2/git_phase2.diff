+def markdown(df):
+    x=df.fillna("").astype(str); return "\n".join(["| "+" | ".join(x.columns)+" |","| "+" | ".join("---" for _ in x.columns)+" |",*["| "+" | ".join(r)+" |" for r in x.itertuples(index=False,name=None)]])
